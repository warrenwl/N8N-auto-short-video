{
  // M5：GLM 自动生成候选选题配置。
  // 修改本文件后，重新触发 /webhook/topic-center 或 /webhook/topic-generate 即可读取新配置。
  // 注意：n8n 容器通过 /config 只读挂载本目录，不需要改 workflow JSON。

  // 复用 01 脚本生成链路的 GLM Coding API Key。
  // 如果 .env 配置了 GLM_MODEL，会优先生效；这里作为页面和请求的兜底模型。
  "model": "glm-5.1",
  "temperature": 0.82,
  // GLM-5.1 会消耗较多 reasoning tokens，过低会导致 JSON 正文被截断。
  "max_tokens": 8000,

  // 页面默认值：用户打开“AI生成”Tab 时会自动填入这些值。
  "defaults": {
    "count": 1,
    "platform": "douyin",
    "account_key": "mes",
    "direction": "普通人破局",
    "category": "认知成长",
    "audience": "30岁左右有焦虑感的普通上班族",
    "style": "理性克制"
  },

  // 数量候选项：默认生成 1 条，适合低成本试题；仍允许自定义输入 1-20 之间的数字。
  "counts": [1, 2, 5, 10],

  // 分类与选题方向联动：
  // - category 是一级内容领域，用于候选池管理、筛选和复盘。
  // - directions 是该分类下的二级栏目/生成范围，不应该直接等同于具体选题。
  // - 具体候选选题由 GLM 根据“分类 + 选题方向 + 目标受众 + 风格”生成。
  "category_direction_groups": [
    {
      "category": "认知成长",
      "directions": [
        "普通人破局",
        "长期主义",
        "判断力训练",
        "行动系统",
        "反馈机制",
        "信息差",
        "反内耗成长",
        "低成本提升"
      ]
    },
    {
      "category": "AI自动化",
      "directions": [
        "办公提效",
        "内容生产",
        "资料整理",
        "个人知识库",
        "自动化工作流",
        "AI 入门方法",
        "AI 工具组合",
        "非技术人提效"
      ]
    },
    {
      "category": "职场效率",
      "directions": [
        "向上沟通",
        "工作汇报",
        "任务拆解",
        "优先级管理",
        "会议效率",
        "职场表达",
        "成果可见化",
        "3-5 年成长瓶颈"
      ]
    },
    {
      "category": "情绪管理",
      "directions": [
        "内耗处理",
        "焦虑拆解",
        "稳定行动",
        "自我认可",
        "边界感",
        "情绪复盘",
        "信息流干扰",
        "结果焦虑"
      ]
    },
    {
      "category": "表达沟通",
      "directions": [
        "口播入门",
        "观点表达",
        "故事开场",
        "结构化表达",
        "内容转述",
        "表达风格",
        "减少废话",
        "个人表达训练"
      ]
    },
    {
      "category": "商业思维",
      "directions": [
        "副业验证",
        "第二增长曲线",
        "低成本试错",
        "个人能力产品化",
        "作品思维",
        "长期复利",
        "需求判断",
        "普通人商业认知"
      ]
    },
    {
      "category": "生活决策",
      "directions": [
        "选择判断",
        "转型决策",
        "关系消耗",
        "消费决策",
        "延迟满足",
        "试错成本",
        "不确定性行动",
        "决策原则"
      ]
    },
    {
      "category": "热点观察",
      "directions": [
        "理性拆解",
        "情绪降噪",
        "立场识别",
        "算法视角",
        "普通人启发",
        "长期方法提炼",
        "舆论观察",
        "信息判断"
      ]
    },
    {
      "category": "副业转型",
      "directions": [
        "副业起步",
        "作品积累",
        "技能变现",
        "内容副业",
        "AI 降本",
        "30 天验证",
        "主业副业平衡",
        "自由职业准备"
      ]
    },
    {
      "category": "读书思考",
      "directions": [
        "读书转行动",
        "知识复利",
        "观点内化",
        "读书复盘",
        "书籍选题拆解",
        "判断力提升",
        "AI 辅助读书",
        "反精神安慰式读书"
      ]
    }
  ],

  // 目标受众：决定 GLM 的痛点、案例、语气和利益点。
  // 配置按分组维护，页面第一版会平铺展示，并在候选 raw_payload 中记录分组来源。
  "audience_groups": [
    {
      "group": "职场阶段",
      "items": [
        "刚毕业1-3年的职场新人",
        "工作3-5年但成长停滞的上班族",
        "30岁左右有焦虑感的普通上班族",
        "中层管理者/小团队负责人",
        "想提升沟通能力的职场人",
        "被琐事消耗、缺少时间管理方法的人"
      ]
    },
    {
      "group": "AI效率",
      "items": [
        "想用AI提升效率但没有技术背景的人",
        "已经开始用AI工具但缺少系统方法的人",
        "想用AI自动化减少重复劳动的人",
        "想把AI用于内容生产和资料整理的人"
      ]
    },
    {
      "group": "内容创作",
      "items": [
        "有表达欲但不敢开始做内容的人",
        "正在尝试做短视频口播的新手",
        "想积累个人IP但缺少选题方法的人",
        "有专业经验但不会转成短视频表达的人"
      ]
    },
    {
      "group": "情绪成长",
      "items": [
        "容易内耗、想变稳定的人",
        "对职业和生活选择感到迷茫的人",
        "想减少无效社交、提升独处质量的人",
        "希望通过读书和思考改变生活状态的人"
      ]
    },
    {
      "group": "副业转型",
      "items": [
        "想做副业但害怕试错的人",
        "收入稳定但想寻找第二增长曲线的人",
        "想转型但不知道如何积累作品的人",
        "自由职业者/个体创业者"
      ]
    },
    {
      "group": "地域与家庭背景",
      "items": [
        "县城/三四线城市想突破信息差的人",
        "普通家庭出身、想靠长期积累改变处境的人",
        "宝妈/家庭角色重但想重新成长的人"
      ]
    }
  ],

  // 内容风格：影响候选标题和角度的表达方式，不等同于后续视频 template_type。
  "styles": [
    "理性克制",
    "温和陪伴",
    "犀利观点",
    "故事开场",
    "实操清单",
    "反常识观点"
  ],

  // 禁用主题：GLM 生成时会被提示避开，后续可继续扩展。
  "blocked_topics": [
    "医疗诊断",
    "投资荐股",
    "夸大收益",
    "贩卖焦虑",
    "搬运他人作品"
  ],

  // 系统提示词：定义 GLM 的角色和输出约束。
  "system_prompt": "你是一个短视频选题策划助手，擅长为抖音口播账号生成可执行、具体、有差异化的候选选题。必须只输出严格 JSON，不要输出 Markdown，不要解释。",

  // 用户提示词模板：支持 {{direction}}、{{count}}、{{category}}、{{audience}}、{{style}}、{{platform}}、{{account_key}}、{{blocked_topics}}。
  // 输出只进入候选池，不会直接生成视频，所以不要输出完整脚本。
  "user_prompt_template": "请为短视频账号生成 {{count}} 条候选选题。\\n平台：{{platform}}\\n账号 key：{{account_key}}\\n一级分类：{{category}}\\n二级选题方向：{{direction}}\\n目标受众：{{audience}}\\n内容风格：{{style}}\\n需要避开的主题：{{blocked_topics}}\\n\\n要求：\\n1. 二级选题方向只是栏目/范围，不是具体题目；你要基于它生成更具体、可拍成短视频的候选选题。\\n2. 选题必须具体，不要泛泛而谈。\\n3. 每条选题适合后续做 45-75 秒竖屏口播视频。\\n4. category 必须使用上面的一级分类，不要另造分类。\\n5. 不要生成 template_type，这个字段由后续 01 脚本生成阶段决定。\\n6. 避免医疗、荐股、夸大收益、煽动焦虑。\\n7. 输出严格 JSON，格式为：{\\\"candidates\\\":[{\\\"topic\\\":\\\"一句话选题\\\",\\\"title\\\":\\\"候选标题\\\",\\\"angle\\\":\\\"切入角度\\\",\\\"audience\\\":\\\"目标受众\\\",\\\"category\\\":\\\"分类\\\",\\\"tags\\\":[\\\"#标签1\\\",\\\"#标签2\\\"]}]}。"
}
