{
  // M5：GLM 自动生成候选选题配置。
  // 修改本文件后，重新触发 /webhook/topic-center 或 /webhook/topic-generate 即可读取新配置。
  // 注意：n8n 容器通过 /config 只读挂载本目录，不需要改 workflow JSON。

  // 复用 01 脚本生成链路的 GLM Coding API Key。
  // 如果 .env 配置了 GLM_MODEL，会优先生效；这里作为页面和请求的兜底模型。
  "model": "glm-5.1",
  "temperature": 0.82,
  // GLM-5.1 会消耗较多 reasoning tokens，过低会导致 JSON 正文被截断。
  "max_tokens": 8000,

  // 页面默认值：用户打开“AI生成”Tab 时会自动填入这些值。
  "defaults": {
    "count": 1,
    "platform": "douyin",
    "account_key": "mes",
    "direction": "认知偏差",
    "category": "认知成长",
    "audience": "30岁左右有焦虑感的普通上班族",
    "tone": "理性克制",
    "content_structure": "反常识观点",
    "style": "理性克制"
  },

  // 数量候选项：默认生成 1 条，适合低成本试题；仍允许自定义输入 1-20 之间的数字。
  "counts": [1, 2, 5, 10],

  // 分类与选题方向联动：
  // - category 是一级内容领域，用于候选池管理、筛选和复盘。
  // - directions 是该分类下的二级栏目/生成范围，不应该直接等同于具体选题。
  // - 具体候选选题由 GLM 根据“分类 + 选题方向 + 目标受众 + 风格”生成。
