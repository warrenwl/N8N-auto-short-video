  // 表达语气：影响措辞、情绪强度和评论区观感。
  "tones": [
    "理性克制",
    "温和陪伴",
    "犀利观点",
    "清醒直接",
    "轻松口语",
    "冷静拆解"
  ],

  // 内容结构：影响选题切入方式，不等同于后续视频 template_type。
  "content_structures": [
    "反常识观点",
    "实操清单",
    "故事开场",
    "误区纠偏",
    "对比拆解",
    "三步方法"
  ],

  // 旧字段保留兼容；页面第一优先读取 tones/content_structures。
  "styles": [
    "理性克制",
    "温和陪伴",
    "犀利观点",
    "反常识观点",
    "实操清单"
  ],

  // 禁用主题：GLM 生成时会被提示避开，后续可继续扩展。
  "blocked_topics": [
    "医疗诊断",
    "投资荐股",
    "夸大收益",
    "贩卖焦虑",
    "搬运他人作品",
    "PUA 操控话术",
    "性别对立煽动"
  ],

  // 系统提示词：定义 GLM 的角色和输出约束。
  "system_prompt": "你是一个短视频选题策划助手，擅长为抖音口播账号生成可执行、具体、有差异化的候选选题。必须只输出严格 JSON，不要输出 Markdown，不要解释。",

  // 用户提示词模板：支持 {{direction}}、{{count}}、{{category}}、{{audience}}、{{tone}}、{{content_structure}}、{{style}}、{{platform}}、{{account_key}}、{{blocked_topics}}。
  // 输出只进入候选池，不会直接生成视频，所以不要输出完整脚本。
  "user_prompt_template": "请为短视频账号生成 {{count}} 条候选选题。\\n平台：{{platform}}\\n账号 key：{{account_key}}\\n一级分类：{{category}}\\n二级选题方向：{{direction}}\\n目标受众：{{audience}}\\n表达语气：{{tone}}\\n内容结构：{{content_structure}}\\n兼容风格：{{style}}\\n需要避开的主题：{{blocked_topics}}\\n\\n质量标准：\\n1. 二级选题方向只是栏目/范围，不是具体题目；你要基于它生成更具体、可拍成短视频的候选选题。\\n2. 每条选题必须有明确冲突、反差、误区或具体场景，不能只是泛泛的成长建议。\\n3. 每条选题必须指向目标受众的一个真实痛点，并说明看完能获得什么。\\n4. 候选适合后续做 45-75 秒竖屏口播视频，不能依赖复杂外拍或长篇资料。\\n5. 不要生成鸡汤化、标题党、空泛励志、无法验证、制造性别对立或贩卖焦虑的内容。\\n6. topic 要是一句话具体选题，不要写成大词，例如不要输出“如何提升认知”“如何变得更自律”。\\n7. category 必须使用上面的一级分类，不要另造分类。\\n8. 不要生成 template_type，这个字段由后续 01 脚本生成阶段决定。\\n9. 避免医疗、荐股、夸大收益、煽动焦虑。\\n\\n输出严格 JSON，不要 Markdown，不要解释。格式为：{\\\"candidates\\\":[{\\\"topic\\\":\\\"一句话具体选题\\\",\\\"title\\\":\\\"候选标题\\\",\\\"angle\\\":\\\"切入角度\\\",\\\"core_angle\\\":\\\"核心角度，8-18字，用于去重\\\",\\\"pain_point\\\":\\\"目标受众的具体痛点\\\",\\\"promise\\\":\\\"看完能获得什么\\\",\\\"opening_hook\\\":\\\"可用于视频开头的一句话钩子\\\",\\\"risk_note\\\":\\\"可能跑偏、敏感、鸡汤或重复的风险；没有则写低风险\\\",\\\"score_reason\\\":\\\"为什么这条值得做\\\",\\\"audience\\\":\\\"目标受众\\\",\\\"category\\\":\\\"分类\\\",\\\"tags\\\":[\\\"#标签1\\\",\\\"#标签2\\\"]}]}。"
}
