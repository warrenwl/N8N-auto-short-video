{
  // Novel workflow V1 generation config.
  // n8n Code nodes read this file from /config/novel_generation_config.jsonc.
  "model": "glm-5.1",
  "temperature": 0.75,
  "max_tokens": 12000,
  "max_tokens_by_prompt": {
    "director": 2200,
    "chapter": 6000,
    "chapter_segment": 2200,
    "chapter_segment_1": 2400,
    "chapter_segment_2": 1800,
    "bible_patch": 2600,
    "review_assistant": 1800
  },
  "thinking": {
    "type": "disabled"
  },
  "prompt_version": "novel-v1-20260504",

  "defaults": {
    "genre": "都市逆袭",
    "audience": "男频爽文读者",
    "style": "节奏快、冲突强、章末留钩子",
    "target_total_chapters": 20,
    "target_words_per_chapter": 2000
  },

  "genres": [
    "都市逆袭",
    "都市脑洞",
    "都市生活",
    "玄幻升级",
    "东方玄幻",
    "仙侠修真",
    "轻小说/异世界",
    "科幻末世",
    "悬疑灵异",
    "历史架空",
    "游戏竞技",
    "现代言情",
    "古代言情",
    "豪门甜宠",
    "种田经营",
    "现实题材"
  ],

  "audiences": [
    "中文网文读者",
    "男频爽文读者",
    "女频情感读者",
    "都市职场读者",
    "玄幻仙侠读者",
    "悬疑烧脑读者",
    "轻松下饭读者",
    "年轻快节奏读者",
    "长线追更读者",
    "短篇试读读者"
  ],

  "styles": [
    "节奏快、冲突强、章末留钩子",
    "爽点密集、打脸反转、情绪直接",
    "沉浸感强、画面细腻、情感递进",
    "轻松幽默、对白灵活、日常爽点",
    "悬疑紧张、伏笔清晰、反转克制",
    "热血燃向、升级明确、目标感强",
    "甜宠轻喜、互动密集、情绪稳定",
    "克制现实、细节扎实、人物可信"
  ],

  "word_count_options": [
    1200,
    1500,
    2000,
    2500,
    3000,
    4000,
    6000,
    8000
  ],

  "blocked_topics": [
    "未成年人不当内容",
    "高风险违法行为教学",
    "现实个人隐私",
    "仇恨或歧视煽动",
    "明确自伤指导"
  ],

  "review": {
    "suggest_rewrite_below": 80,
    "manual_review_always": true
  },

  "system_prompts": {
    "bible": "你是一名成熟的商业网文策划编辑。必须只输出严格 JSON。",
    "bible_patch": "你是一名商业网文设定集连续性编辑。必须只输出严格 JSON。",
    "outline": "你是一名商业网文大纲策划。必须只输出严格 JSON。",
    "director": "你是一名商业网文导演、连续性编辑和伏笔管理者。必须只输出严格 JSON，不写正文。",
    "chapter": "你是一名成熟的商业网文作者。必须只输出严格 JSON。",
    "review": "你是一名严格的商业网文编辑。必须只输出严格 JSON。",
    "rewrite": "你是一名商业网文改稿编辑。必须只输出严格 JSON。",
    "review_assistant": "你是一名商业网文审稿副驾驶、连续性编辑和剧情顾问。必须只输出严格 JSON。"
  },

  "user_prompt_templates": {
    "bible": "请根据以下小说项目资料，生成完整的小说 Bible。\\n\\n【小说名】{{title}}\\n【核心创意】{{premise}}\\n【禁区】{{blocked_topics}}\\n\\n{{creative_brief}}\\n\\n要求：类型决定主爽点、冲突形态和升级路径；目标读者决定情绪兑现方式；文风必须固化进 tone_rules；target_words_per_chapter 决定后续章节的信息密度。不要生成全类型通用设定。角色命名必须建立唯一主名：每个角色的 name 是后续大纲和正文的唯一主名；如需要公开身份、伪名、亲昵称呼或真实身份，必须写入 aliases、public_name 或 identity_note，不得留给大纲阶段临时创造。重要组织、商会、家族、宗门、公司、地点和长期约束必须进入 organizations、locations、plot_constraints，不能只写在摘要里。JSON 字段名可以保持示例里的机器字段，但所有字段值、描述、角色设定内容必须使用中文；不要在字段值中输出 name、goal、identity、relationship_with_mc 等英文 schema 说明。\\n\\n输出 JSON：{\\\"world_setting\\\":\\\"\\\",\\\"story_core\\\":\\\"\\\",\\\"main_character\\\":{\\\"name\\\":\\\"\\\",\\\"aliases\\\":[],\\\"public_name\\\":\\\"\\\",\\\"age\\\":\\\"\\\",\\\"identity\\\":\\\"\\\",\\\"identity_note\\\":\\\"\\\",\\\"personality\\\":\\\"\\\",\\\"goal\\\":\\\"\\\",\\\"weakness\\\":\\\"\\\",\\\"growth_arc\\\":\\\"\\\"},\\\"supporting_characters\\\":[{\\\"name\\\":\\\"\\\",\\\"aliases\\\":[],\\\"public_name\\\":\\\"\\\",\\\"identity\\\":\\\"\\\",\\\"identity_note\\\":\\\"\\\",\\\"relationship_with_mc\\\":\\\"\\\"}],\\\"villain_setting\\\":[{\\\"name\\\":\\\"\\\",\\\"aliases\\\":[],\\\"public_name\\\":\\\"\\\",\\\"identity\\\":\\\"\\\",\\\"identity_note\\\":\\\"\\\",\\\"conflict_with_mc\\\":\\\"\\\"}],\\\"organizations\\\":[{\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"商会/家族/宗门/公司/机构\\\",\\\"role\\\":\\\"\\\",\\\"leader\\\":\\\"\\\",\\\"interest\\\":\\\"\\\",\\\"conflict_with_mc\\\":\\\"\\\"}],\\\"locations\\\":[{\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"\\\",\\\"owner\\\":\\\"\\\",\\\"story_function\\\":\\\"\\\"}],\\\"plot_constraints\\\":[{\\\"constraint\\\":\\\"\\\",\\\"reason\\\":\\\"\\\",\\\"until_chapter\\\":null}],\\\"power_system\\\":\\\"\\\",\\\"relationship_map\\\":[],\\\"expansion_notes\\\":\\\"\\\",\\\"tone_rules\\\":\\\"\\\",\\\"forbidden_rules\\\":\\\"\\\",\\\"selling_points\\\":[]}",
    "bible_patch": "请根据扩写计划，为现有小说 Bible 生成“设定集补丁”。不要重写完整 Bible，只输出可人工确认后合并的新增/修正项。\\n\\n【小说名】{{title}}\\n【类型/读者/文风】{{genre}} / {{audience}} / {{style}}\\n【扩写剧情要求】{{expansion_request}}\\n【扩写范围】{{expansion_scope}}\\n【保留约束】{{expansion_constraints}}\\n【当前 Bible】{{novel_bible}}\\n【已有大纲】{{existing_outlines}}\\n【已批准章节摘要】{{approved_chapters}}\\n【已激活连续性事实】{{continuity_facts}}\\n\\n要求：\\n1. 只补新增人物、组织/商会/家族/势力、地点、关系、反派/阻力和长期剧情约束。\\n2. 不要覆盖已有角色主名，不要重命名已批准正文中出现过的人物。\\n3. 新组织/家族/商会必须写清 type、role、leader/representative、interest、conflict_with_mc、first_touch_suggestion。\\n4. 新人物必须写清 name、aliases、identity、motivation、relationship_with_mc、first_touch_suggestion。\\n5. 如果扩写要求与已批准正文或已激活事实冲突，写入 risk_notes，不要强行改旧设定。\\n6. append_only 只能补后续设定；rewrite_unwritten 可以补未写章节需要的关系/阻力；regenerate_outline 也不能要求修改已批准正文。\\n\\n输出 JSON：{\\\"summary\\\":\\\"\\\",\\\"new_characters\\\":[{\\\"name\\\":\\\"\\\",\\\"aliases\\\":[],\\\"identity\\\":\\\"\\\",\\\"motivation\\\":\\\"\\\",\\\"relationship_with_mc\\\":\\\"\\\",\\\"first_touch_suggestion\\\":\\\"\\\"}],\\\"new_villains\\\":[{\\\"name\\\":\\\"\\\",\\\"aliases\\\":[],\\\"identity\\\":\\\"\\\",\\\"motivation\\\":\\\"\\\",\\\"conflict_with_mc\\\":\\\"\\\",\\\"threat_level\\\":\\\"\\\"}],\\\"new_organizations\\\":[{\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"\\\",\\\"role\\\":\\\"\\\",\\\"leader\\\":\\\"\\\",\\\"interest\\\":\\\"\\\",\\\"conflict_with_mc\\\":\\\"\\\",\\\"first_touch_suggestion\\\":\\\"\\\"}],\\\"new_locations\\\":[{\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"\\\",\\\"owner\\\":\\\"\\\",\\\"story_function\\\":\\\"\\\"}],\\\"relationship_updates\\\":[{\\\"from\\\":\\\"\\\",\\\"to\\\":\\\"\\\",\\\"relationship\\\":\\\"\\\",\\\"reason\\\":\\\"\\\"}],\\\"plot_constraints\\\":[{\\\"constraint\\\":\\\"\\\",\\\"reason\\\":\\\"\\\",\\\"until_chapter\\\":null}],\\\"expansion_notes\\\":\\\"\\\",\\\"risk_notes\\\":[{\\\"risk\\\":\\\"\\\",\\\"evidence\\\":\\\"\\\",\\\"suggested_fix\\\":\\\"\\\"}]}",
    "outline": "请根据小说 Bible 生成章节大纲。\\n\\n【小说标题】{{title}}\\n【核心故事】{{story_core}}\\n【世界观】{{world_setting}}\\n【主角】{{main_character}}\\n【配角】{{supporting_characters}}\\n【反派】{{villain_setting}}\\n【人物关系】{{relationship_map}}\\n【组织势力】{{organizations}}\\n【关键地点】{{locations}}\\n【剧情约束】{{plot_constraints}}\\n【扩写备注】{{expansion_notes}}\\n【能力体系】{{power_system}}\\n【卖点】{{selling_points}}\\n【文风规则】{{tone_rules}}\\n【禁止事项】{{forbidden_rules}}\\n【目标章节数】{{target_total_chapters}}\\n\\n{{creative_brief}}\\n\\n要求：每章有明确冲突、情绪点和章末钩子；前 3 章快速建立主角目标、核心矛盾和追更理由；短章只放一个核心冲突，长章可以安排主冲突加一次转折；不要重复剧情；每章推动主线、人物关系或伏笔变化。新增人物、组织势力、关键地点、长期约束和扩写备注必须落实到后续章节安排，不能只停留在总述。章节标题规则：chapters[].title 只写标题本身，不要带“第1章”“第一章”“第X章”等章节序号前缀；章节序号只能写在 chapter_no 字段里。角色名必须只使用 Bible 中已登记的 name、aliases 或 public_name；如果 Bible 没有登记别名，不得写“X（实为Y）”这类临时双名；如果需要公开称呼和真实身份并存，必须在 summary 首次出现时明确“主名（公开称呼：别名）”，后续保持一致。\\n\\n输出 JSON：{\\\"chapters\\\":[{\\\"chapter_no\\\":1,\\\"volume_no\\\":1,\\\"title\\\":\\\"\\\",\\\"summary\\\":\\\"\\\",\\\"chapter_goal\\\":\\\"\\\",\\\"conflict_point\\\":\\\"\\\",\\\"emotional_point\\\":\\\"\\\",\\\"hook\\\":\\\"\\\"}]}",
    "director": "请为当前章节生成“导演台规划”。这是正文生成前的质量控制层，只写短规划，不写正文。\\n\\n【小说标题】{{novel_title}}\\n【类型/读者/文风】{{genre}} / {{audience}} / {{style}}\\n【目标字数】{{target_words_per_chapter}}\\n【正文分段数】{{chapter_segment_total}}\\n【小说 Bible】{{novel_bible}}\\n【当前章节】第 {{chapter_no}} 章：{{outline_title}}\\n【本章大纲】{{outline_summary}}\\n【本章目标】{{chapter_goal}}\\n【本章冲突】{{conflict_point}}\\n【情绪点】{{emotional_point}}\\n【章末钩子】{{hook}}\\n【前 1-3 章正式摘要】{{previous_chapters}}\\n【后 1-3 章大纲】{{future_outlines}}\\n【连续性事实】{{continuity_facts}}\\n【伏笔账本】{{plot_threads}}\\n【最近审稿问题】{{recent_review_issues}}\\n\\n{{creative_brief}}\\n\\n要求：\\n1. 只输出严格 JSON，不要 Markdown，不要解释。\\n2. 不得写 segment_body、chapter_body 或任何正文段落；segment_plan 只能是短计划。\\n3. 必须检查因果链：上一章如何推到本章，本章事件为什么现在发生，人物为什么这样行动，本章造成什么不可逆变化，又如何自然推向下一章。\\n4. 必须检查突兀风险：如果角色突然相信、突然出场、突然获得线索、突然反转、伤势/时间线不合理，要写入 abruptness_risks 和 fix。\\n5. 必须管理伏笔：seed/touch/payoff/avoid_reveal 四选一；如果后文才可揭露，必须标记 do_not_reveal=true。\\n6. quality_gate.pass=false 只用于重大断裂、事实来源不足或提前揭露；一旦 false，blocking_issues 必须说明可操作修法。\\n7. segment_plan 数量必须严格等于【正文分段数】，每段计划不超过 160 个中文字符。\\n8. fact_source_audit 必须审计本章用到的制度性理由、新案名、新身份、新命令、新强制措施或关键转场依据；没有来源的 claim 必须 verdict=unsupported，并让 quality_gate.pass=false。\\n9. 制度性理由不能用“推断”“本章新增”“创作处理”当 supported；从物品或线索升级为案名、相关人等、口头命令、集中看护、强制转移，必须有同级来源证据。\\n\\n输出 JSON：{\\\"chapter_intent\\\":\\\"\\\",\\\"causal_chain\\\":{\\\"from_previous\\\":\\\"\\\",\\\"trigger\\\":\\\"\\\",\\\"character_motives\\\":[\\\"\\\"],\\\"obstacles\\\":[\\\"\\\"],\\\"irreversible_result\\\":\\\"\\\",\\\"to_next\\\":\\\"\\\"},\\\"continuity_constraints\\\":{\\\"must_remember\\\":[\\\"\\\"],\\\"must_not_break\\\":[\\\"\\\"],\\\"future_outline_guardrails\\\":[\\\"\\\"]},\\\"foreshadowing_ops\\\":[{\\\"thread_key\\\":\\\"\\\",\\\"action\\\":\\\"seed\\\",\\\"instruction\\\":\\\"\\\",\\\"do_not_reveal\\\":true,\\\"next_touch_chapter\\\":null,\\\"payoff_target_chapter\\\":null,\\\"do_not_reveal_before\\\":null,\\\"visibility\\\":\\\"\\\"}],\\\"abruptness_risks\\\":[{\\\"risk\\\":\\\"\\\",\\\"reason\\\":\\\"\\\",\\\"fix\\\":\\\"\\\"}],\\\"fact_source_audit\\\":[{\\\"claim\\\":\\\"\\\",\\\"source_type\\\":\\\"\\\",\\\"source_evidence\\\":\\\"\\\",\\\"verdict\\\":\\\"supported\\\"}],\\\"quality_gate\\\":{\\\"pass\\\":true,\\\"blocking_issues\\\":[]},\\\"segment_plan\\\":[{\\\"segment_no\\\":1,\\\"goal\\\":\\\"\\\",\\\"conflict\\\":\\\"\\\",\\\"information_release\\\":\\\"\\\",\\\"emotion_turn\\\":\\\"\\\",\\\"ending_hook\\\":\\\"\\\"}]}",
    "chapter": "请根据以下资料生成当前章节正文。\\n\\n【小说标题】{{novel_title}}\\n【世界观】{{world_setting}}\\n【故事核心】{{story_core}}\\n【主角设定】{{main_character}}\\n【配角设定】{{supporting_characters}}\\n【反派设定】{{villain_setting}}\\n【人物关系】{{relationship_map}}\\n【组织势力】{{organizations}}\\n【关键地点】{{locations}}\\n【剧情约束】{{plot_constraints}}\\n【扩写备注】{{expansion_notes}}\\n【能力体系】{{power_system}}\\n【文风规则】{{tone_rules}}\\n【禁止事项】{{forbidden_rules}}\\n【上一章已批准摘要】{{previous_chapter_summary}}\\n【必须保持一致的关键事实】{{continuity_facts}}\\n【当前章节】第 {{chapter_no}} 章：{{outline_title}}\\n【本章大纲】{{outline_summary}}\\n【本章目标】{{chapter_goal}}\\n【本章冲突】{{conflict_point}}\\n【情绪点】{{emotional_point}}\\n【结尾钩子】{{hook}}\\n\\n{{creative_brief}}\\n\\n角色称呼一致性：正文必须以 Bible 中的 name 为唯一主名；只有 Bible 明确登记 aliases 或 public_name 时才可使用别名；大纲中若出现未登记的括号身份说明，以 Bible 为准，不得把角色改名。\\n\\n章节标题规则：chapter_title 只写标题本身，不要带“第1章”“第一章”“第X章”等章节序号前缀；章节序号由系统根据 chapter_no 统一展示。\\n\\n正文换行硬规则：chapter_body 必须使用 \\\\n 做常规网文节奏换行，不要输出整块大段；对话必须单独成段；对话前后的动作、反应、心理活动要分段；每段只承载一个动作、一次对话、一段心理或一个转折；普通段建议 40-120 个中文字符，单段超过 160 字视为失败；不要用空行凑段，不要把多轮对话写在同一段。\\n\\nJSON安全：正文只能写在 chapter_body 字符串里，正文不得散落到其他 JSON 字段名；不要把任何小说句子、对白、动作或心理描写作为 JSON key；正文内不要使用半角英文双引号 \\\" 表示对白、拟声或强调，统一使用中文引号“”；半角双引号容易截断 JSON 字符串；输出前自检 JSON 顶层只能包含指定字段。\\n\\n写作要求：正文长度控制在目标字数上下 15% 内；开头 300 字内进入冲突或悬念；写成具体场景，不写大段设定说明；对话推动剧情；至少一次情绪波动；优先满足项目文风，其次遵守 Bible 文风规则；不改变已有设定；不提前揭露伏笔；结尾留下强钩子。\\n\\n输出 JSON：{\\\"chapter_title\\\":\\\"\\\",\\\"chapter_body\\\":\\\"\\\",\\\"chapter_summary\\\":\\\"\\\",\\\"word_count_estimate\\\":0,\\\"new_facts\\\":[{\\\"fact_type\\\":\\\"character\\\",\\\"fact_key\\\":\\\"\\\",\\\"fact_value\\\":\\\"\\\",\\\"confidence\\\":0.8}],\\\"foreshadowing\\\":[{\\\"fact_key\\\":\\\"\\\",\\\"fact_value\\\":\\\"\\\",\\\"confidence\\\":0.8}]}",
    "review": "请审查以下章节。\\n\\n【小说 Bible】{{novel_bible}}\\n【关键事实】{{continuity_facts}}\\n【目标字数】{{target_words_per_chapter}}\\n【允许范围】{{target_word_lower_bound}}-{{target_word_upper_bound}}\\n【系统统计字数】{{chapter_word_count}}\\n【正文字符数】{{chapter_body_chars}}\\n【章节正文】{{chapter_body}}\\n\\n{{creative_brief}}\\n\\n请按该类型、目标读者和文风来评分，不要用全类型统一标准。重点检查：设定一致性、可读性、段落节奏、对话是否独立成段、剧情推进、商业追更感、文风匹配度、目标字数偏离。字数判断必须以【系统统计字数】为唯一依据，不要自行估算，不要写“约600字”这类没有系统依据的描述；如字数偏离，只能引用系统统计字数和允许范围。问题描述必须基于正文证据，不得推测作者动机，不得写“作者明显为了……”这类主观归因。字数 severity 分级：低于允许下限但仍达到目标字数 70% 以上，最多标 medium；低于目标 70% 或正文明显残缺时才标 high。若正文明显偏离类型期待、读者情绪、段落可读性或字数目标，必须写入 issues。\\n\\n输出 JSON：{\\\"consistency_score\\\":0,\\\"readability_score\\\":0,\\\"plot_score\\\":0,\\\"commercial_score\\\":0,\\\"total_score\\\":0,\\\"issues\\\":[{\\\"type\\\":\\\"\\\",\\\"description\\\":\\\"\\\",\\\"severity\\\":\\\"low\\\"}],\\\"suggestions\\\":[],\\\"verdict\\\":\\\"PASS\\\"}",
    "rewrite": "下面是原章节正文和审稿意见，请在不改变核心剧情、不改变已有设定的前提下重写章节。\\n\\n【小说标题】{{novel_title}}\\n【小说 Bible】{{novel_bible}}\\n【原章节】{{chapter_body}}\\n【审稿问题】{{issues}}\\n【修改建议】{{suggestions}}\\n【人工意见】{{human_comment}}\\n【必须保持的关键事实】{{continuity_facts}}\\n【本章大纲】{{outline_summary}}\\n【本章目标】{{chapter_goal}}\\n【本章冲突】{{conflict_point}}\\n【情绪点】{{emotional_point}}\\n【结尾钩子】{{hook}}\\n\\n{{creative_brief}}\\n\\n重写依据优先级：必须逐条阅读并落实【审稿问题】和【修改建议】，这些是本次重写的主要修改清单，不得只做轻微润色；如果【人工意见】与智能审稿一致或为空，按智能审稿的问题与建议逐条修改；如果【人工意见】提出额外要求，优先满足人工意见，同时保留智能审稿中不冲突的问题修复；高/中风险问题必须在新正文中明显修正，低风险建议至少吸收为节奏、细节或钩子优化。\\n\\n角色称呼一致性：正文必须以 Bible 中的 name 为唯一主名；只有 Bible 明确登记 aliases 或 public_name 时才可使用别名；大纲中若出现未登记的括号身份说明，以 Bible 为准，不得把角色改名。\\n\\n章节标题规则：chapter_title 只写标题本身，不要带“第1章”“第一章”“第X章”等章节序号前缀；章节序号由系统根据 chapter_no 统一展示。\\n\\n正文换行硬规则：chapter_body 必须使用 \\\\n 做常规网文节奏换行，不要输出整块大段；对话必须单独成段；对话前后的动作、反应、心理活动要分段；每段只承载一个动作、一次对话、一段心理或一个转折；普通段建议 40-120 个中文字符，单段超过 160 字视为失败；不要用空行凑段，不要把多轮对话写在同一段。\\n\\nJSON安全：正文只能写在 chapter_body 字符串里，正文不得散落到其他 JSON 字段名；不要把任何小说句子、对白、动作或心理描写作为 JSON key；正文内不要使用半角英文双引号 \\\" 表示对白、拟声或强调，统一使用中文引号“”；半角双引号容易截断 JSON 字符串；输出前自检 JSON 顶层只能包含指定字段。\\n\\n写作要求：强化人工意见中要求的改动；保留已批准前文事实；重写后仍要符合类型、目标读者、文风和目标字数；如本章新增或修正了人物、物品、组织、地点、能力、关系、时间线、规则或伏笔，必须写入 new_facts；不要返回空的 new_facts，除非本章确实没有任何新增或修正事实。\\n\\n输出 JSON：{\\\"chapter_title\\\":\\\"\\\",\\\"chapter_body\\\":\\\"\\\",\\\"chapter_summary\\\":\\\"\\\",\\\"word_count_estimate\\\":0,\\\"new_facts\\\":[{\\\"fact_type\\\":\\\"other\\\",\\\"fact_key\\\":\\\"\\\",\\\"fact_value\\\":\\\"\\\",\\\"confidence\\\":0.8}]}"
  }
}
